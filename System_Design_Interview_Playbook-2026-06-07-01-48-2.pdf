BT 1 0 0 1 10 331 Tm (// OpenFeign, cleanest for microservice calls:) Tj T* ET
BT 1 0 0 1 10 318 Tm (@FeignClient\(name = "payment-service", fallback = PaymentFallback.class\)) Tj T* ET
BT 1 0 0 1 10 305 Tm (public interface PaymentClient {) Tj T* ET
BT 1 0 0 1 10 292 Tm (    @PostMapping\("/api/payments"\)) Tj T* ET
BT 1 0 0 1 10 279 Tm (    PaymentResponse processPayment\(@RequestBody PaymentRequest req\);) Tj T* ET
BT 1 0 0 1 10 266 Tm (}) Tj T* ET
BT 1 0 0 1 10 253 Tm  T* ET
BT 1 0 0 1 10 240 Tm (// Use it like a local service bean:) Tj T* ET
BT 1 0 0 1 10 227 Tm (@Autowired PaymentClient paymentClient;) Tj T* ET
BT 1 0 0 1 10 214 Tm (PaymentResponse result = paymentClient.processPayment\(request\);) Tj T* ET
BT 1 0 0 1 10 201 Tm  T* ET
BT 1 0 0 1 10 188 Tm (// Fallback when payment service is down:) Tj T* ET
BT 1 0 0 1 10 175 Tm (@Component) Tj T* ET
BT 1 0 0 1 10 162 Tm (public class PaymentFallback implements PaymentClient {) Tj T* ET
BT 1 0 0 1 10 149 Tm (    public PaymentResponse processPayment\(PaymentRequest req\) {) Tj T* ET
BT 1 0 0 1 10 136 Tm (        return PaymentResponse.pending\("queued for retry"\);) Tj T* ET
BT 1 0 0 1 10 123 Tm (    }) Tj T* ET
BT 1 0 0 1 10 110 Tm (}) Tj T* ET
BT 1 0 0 1 10 97 Tm  T* ET
BT 1 0 0 1 10 84 Tm (// WebClient, for reactive or mixed flows:) Tj T* ET
BT 1 0 0 1 10 71 Tm (webClient.post\(\).uri\("/api/payments"\)) Tj T* ET
BT 1 0 0 1 10 58 Tm (         .bodyValue\(request\)) Tj T* ET
BT 1 0 0 1 10 45 Tm (         .retrieve\(\)) Tj T* ET
BT 1 0 0 1 10 32 Tm (         .bodyToMono\(PaymentResponse.class\)) Tj T* ET
